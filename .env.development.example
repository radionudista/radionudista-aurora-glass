# Copy to .env.development (gitignored) for local editor host on branch `dev`.
# git checkout dev && npm run dev

VITE_APP_DEBUG=true
VITE_APP_ENVIRONMENT=local
VITE_EDITOR_ENABLED=true

VITE_SUPPORTED_LANGUAGES=es,pt,en
VITE_DEFAULT_LANGUAGE=es

# Google Calendar (página de programación)
VITE_CALENDAR_API_KEY=
VITE_CALENDAR_ID=
VITE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires
VITE_CALENDAR_MAX_RESULTS=2500
VITE_CALENDAR_SINGLE_EVENTS=true
VITE_CALENDAR_ORDER_BY=startTime

# Editor auth — SALT + HASH (login en /editor-login)
# Generar SALT: openssl rand -hex 32
# Generar HASH: echo -n "<SALT><PASSWORD>" | openssl dgst -sha256 | awk '{print $2}'
VITE_EDITOR_SALT=change-me-salt
VITE_EDITOR_PASSWORD_HASH=change-me-hash

# Editor publish target (must match checked-out branch)
EDITOR_GIT_BRANCH=master
EDITOR_GIT_REMOTE=origin
EDITOR_GITHUB_TOKEN=

# Internet Archive (subida de audio desde el editor)
IA_ACCESS_KEY=
IA_SECRET_KEY=
IA_COLLECTION=opensource_audio

# Traducción automática (editor dev)
TRANSLATE_API_URL=https://libretranslate.com/translate
TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_URL=
GOOGLE_TRANSLATE_API_KEY=
EDITOR_TRANSLATE_MONTHLY_CHAR_LIMIT=500000
