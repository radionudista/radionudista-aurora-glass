# Environment Configuration Example

# Copy this file to .env, .env.development, or .env.feature and configure for your environment



# Túnel público (npm run dev:tunnel): usa ngrok.

# https://dashboard.ngrok.com/get-started/your-authtoken — o: ngrok config add-authtoken <token>

# NGROK_AUTHTOKEN=

# NGROK_LOCAL_PORT=8080

# TUNNEL_PROVIDER=ngrok



# Application Environment - Controls which environment the app is running in

# Options: production, local, feature

VITE_APP_ENVIRONMENT=local



# Debug Mode - Enables/disables console logging

# Options: true, false

VITE_APP_DEBUG=true



# Supported UI languages (routing + i18n)

VITE_SUPPORTED_LANGUAGES=es,pt,en

VITE_DEFAULT_LANGUAGE=es



# Launch Date - The date when the countdown should end and switch to Twitch player

# Format: ISO 8601 datetime string with timezone

VITE_LAUNCHING_DATE=2025-08-09T12:00:00-03:00



# Twitch Source URL - The iframe source URL for the Twitch player

VITE_TWITCH_SRC_URL=https://player.twitch.tv/?channel=radionudista&parent=radionudista.com&parent=localhost&parent=127.0.0.1&parent=radionudista-aurora-glass.pages.dev&parent=lovable.dev&autoplay=true&muted=false



# Stream URL - Direct link to the Twitch stream (for fallback and external links)

VITE_STREAM_URL=https://twitch.tv/radionudista



# Twitch Player Window Size - Percentage of browser canvas the player should occupy

VITE_TWITCH_PLAYER_WINDOW_SIZE_PERCENT=70



# Google Calendar (browser key + public calendar id)

VITE_CALENDAR_API_KEY=

VITE_CALENDAR_ID=

VITE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires

VITE_CALENDAR_MAX_RESULTS=2500

VITE_CALENDAR_SINGLE_EVENTS=true

VITE_CALENDAR_ORDER_BY=startTime



# Supabase (cliente — mismo criterio en local y prod; editor en /editor-login)
# Imágenes del editor: buckets program-logos + episode-covers (ver scripts/supabase-storage-setup.sql)

VITE_SUPABASE_URL=

VITE_SUPABASE_ANON_KEY=



# Supabase (servidor local + Cloudflare Functions: subida audio / traducir)
# En dev basta copiar los mismos valores que VITE_SUPABASE_* si no querés duplicar en .env.
# En Cloudflare Pages: Settings → Environment variables (Functions, no Build).

SUPABASE_URL=

SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_EDITOR_EMAIL=

SUPABASE_EDITOR_PASSWORD=

DATABASE_URL=



# Archive.org (solo edge: subida de audio de episodios)

IA_ACCESS_KEY=

IA_SECRET_KEY=

IA_COLLECTION=opensource_audio

# Bulk upload (npm run bulk:archive -- --dir=C:/carpeta)
# IA_BULK_DELAY_SEC=45
# FFMPEG_PATH=
# AUP2WAV_PY=scripts/vendor/aup2wav.py
# PYTHON_PATH=py



# Traducción automática del editor (edge)

TRANSLATE_API_URL=https://libretranslate.com/translate

TRANSLATE_API_KEY=

GOOGLE_TRANSLATE_API_URL=

GOOGLE_TRANSLATE_API_KEY=

EDITOR_TRANSLATE_MONTHLY_CHAR_LIMIT=500000

